          period="7"/>

    <flow id="flow5"
          type="car"
          route="r7"
          begin="0"
          end="1000"
          period="6"/>

    <flow id="flow6"
          type="car"
          route="r8"
          begin="0"
          end="1000"
          period="6"/>

    <flow id="flow7"
          type="car"
          route="r9"
          begin="0"
          end="1000"
          period="8"/>

    <flow id="flow8"
          type="car"
          route="r10"
          begin="0"
          end="1000"
          period="8"/>

</routes>