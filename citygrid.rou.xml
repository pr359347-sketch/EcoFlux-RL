           accel="2.6"
           decel="4.5"
           sigma="0.5"
           length="5"
           minGap="2.5"
           maxSpeed="13.9"/>

    <!-- Routes -->

    <!-- Horizontal -->
    <route id="r1" edges="A0A1 A1A2"/>
