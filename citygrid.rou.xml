    <route id="r9" edges="A1B1 B1C1"/>
    <route id="r10" edges="C1B1 B1A1"/>

    <route id="r11" edges="A2B2 B2C2"/>
    <route id="r12" edges="C2B2 B2A2"/>

    <!-- Traffic Flows -->

    <flow id="flow1"
          type="car"
          route="r1"
          begin="0"
          end="1000"
          period="5"/>

    <flow id="flow2"
          type="car"
